[face_recognition]
# Replace with the EC2 public IP or DNS name after launching the instance.
# Do not commit your real private-key path or inventory containing sensitive details.
EC2_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=PATH_TO_YOUR_PEM_FILE

[face_recognition:vars]
aws_region=ap-south-1
aws_account_id=080705554676
ecr_repository=face-recognition-system
image_tag=latest
app_port=5000
container_name=face-recognition-system
