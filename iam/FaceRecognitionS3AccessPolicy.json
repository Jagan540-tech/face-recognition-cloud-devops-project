{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListFaceRecognitionBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::jaganops-face-recognition-data-080705554676"
        },
        {
            "Sid": "ManageFaceRecognitionObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::jaganops-face-recognition-data-080705554676/*"
        }
    ]
}